{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EmuWorld",
  "version": "2.5.1",
  "identifier": "com.emuworld.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "EmuWorld",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": false,
        "transparent": false,
        "maximized": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' https://*.supabase.co https://tinfoil.media https://thumbnails.libretro.com https://art.gametdb.com https://archive.org https://upload.wikimedia.org https://raw.githubusercontent.com https://avatars.githubusercontent.com https://git.ryujinx.app data: blob: asset:; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://retroachievements.org https://thumbnails.libretro.com https://tinfoil.media https://art.gametdb.com https://archive.org; font-src 'self' data:; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'",
      "assetProtocol": {
        "scope": ["$APPDATA/EmuWorld/**", "$RESOURCE/**"]
      }
    }
  },
  "bundle": {
    "publisher": "EmuWorld",
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "resources": ["binaries/7za.exe"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "language": ["fr-FR", "en-US"]
      }
    }
  },
  "plugins": {
    "deep-link": {
      "schemes": ["emuworld"]
    },
    "single-instance": null,
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/fj123u/EmuWorld/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDUxQkYwNjM1NEQ1QTNDNkQKUldSdFBGcE5OUWEvVVpWMnhNV2RMYnZDWjY3RVh6aVZxd2xRc3pMSnFsUlNCaThxcE8xK1hjbVoK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
