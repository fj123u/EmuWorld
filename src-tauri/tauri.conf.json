{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EmuWorld",
  "version": "2.0.0",
  "identifier": "com.emuworld.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "EmuWorld",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": false,
        "transparent": false,
        "maximized": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "publisher": "EmuWorld",
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "resources": ["binaries/7za.exe"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "language": ["fr-FR", "en-US"]
      }
    }
  },
  "plugins": {
    "deep-link": {
      "schemes": ["emuworld"]
    },
    "single-instance": null,
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/fj123u/EmuWorld/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNGNDAwNDQ0QzQxOUYyQkIKUldTNzhobkVSQVJBUDR4SUMyYnJrY2pGMGh3d0F2VEc5cCtqRjRDZVp0MVVzLzZFMTNKbGQ2MmcK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
